ENV_FILE=.env.production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/driver_app?schema=public
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-admin.json
ADMIN_API_KEY=replace-with-a-strong-random-secret
ALLOW_ADMIN_API_KEY_FALLBACK=false
ALLOWED_WEB_ORIGINS=https://ops.example.com,https://merchant.example.com,https://store.example.com
METRICS_API_KEY=replace-with-a-strong-random-secret
WEB_SESSION_COOKIE_SECURE=true
WEB_SESSION_COOKIE_DOMAIN=.example.com
WEB_SESSION_COOKIE_SAME_SITE=Strict
WEB_SESSION_COOKIE_MAX_AGE_SECONDS=43200
SESSION_TTL_HOURS=12
STALE_LOCATION_MINUTES=5
DISPATCH_INTERVAL_MS=5000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_BASE_URL=https://ops.example.com/reset-password
GOOGLE_MAPS_API_KEY=
REDIS_URL=
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300
ALLOW_INSECURE_PASSWORD_RESET_TOKEN_RESPONSE=false
