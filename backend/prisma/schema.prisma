generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  driver
  restaurant
  merchant
  admin
}

enum AuditActorType {
  driver
  restaurant
  admin
  system
  merchant
}

model Merchant {
  id          String       @id
  name        String
  users       Json         @default("[]")
  restaurants Restaurant[]

  @@map("merchants")
}

model Driver {
  id              String   @id
  name            String
  email           String   @unique
  password        String
  rating          Float
  completedOrders Int      @map("completed_orders")
  totalDistanceKm Float    @map("total_distance_km")
  isOnline        Boolean  @map("is_online")
  currentLocation Json     @map("current_location")
  deviceToken     String?  @map("device_token")
  dispatchPolicy  Json     @map("dispatch_policy")
  maxActiveOrders Int      @map("max_active_orders")
  assignedOrders  Order[]  @relation("AssignedDriverOrders")

  @@map("drivers")
}

model Restaurant {
  id                       String   @id
  merchantId               String   @map("merchant_id")
  name                     String
  email                    String   @unique
  password                 String
  pickupLocation           Json     @map("pickup_location")
  driverRatePerOrder       Float    @map("driver_rate_per_order")
  restaurantChargePerOrder Float    @map("restaurant_charge_per_order")
  currency                 String
  trackingSettings         Json     @map("tracking_settings")
  staffUsers               Json     @map("staff_users") @default("[]")
  merchant                 Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders                   Order[]

  @@map("restaurants")
}

model AdminUser {
  id          String    @id
  name        String
  email       String    @unique
  password    String
  role        String
  isActive    Boolean   @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model Order {
  id                          String     @id
  restaurantId                String     @map("restaurant_id")
  restaurant                  Json
  customer                    Json
  deliveryArea                String     @map("delivery_area")
  status                      String
  distanceKm                  Float      @map("distance_km")
  estimatedKm                 Float      @map("estimated_km")
  estimatedMinutes            Int        @map("estimated_minutes")
  tripEarnings                Float      @map("trip_earnings")
  companyCharge               Float      @map("company_charge")
  createdAt                   DateTime   @map("created_at") @db.Timestamptz(6)
  expiresAt                   DateTime?  @map("expires_at") @db.Timestamptz(6)
  assignedDriverId            String?    @map("assigned_driver_id")
  rejectedDriverIds           Json       @map("rejected_driver_ids")
  deliveredAt                 DateTime?  @map("delivered_at") @db.Timestamptz(6)
  pendingDispatchNotification Boolean    @map("pending_dispatch_notification")
  events                      Json
  restaurantRecord            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedDriver              Driver?    @relation("AssignedDriverOrders", fields: [assignedDriverId], references: [id])

  @@index([restaurantId], map: "idx_orders_restaurant_id")
  @@index([assignedDriverId], map: "idx_orders_assigned_driver_id")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model Session {
  token     String   @id
  userType  UserType @map("user_type")
  userId    String   @map("user_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id
  userType  UserType @map("user_type")
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_password_reset_tokens_expires_at")
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String         @id
  at         DateTime       @db.Timestamptz(6)
  actorType  AuditActorType @map("actor_type")
  actorId    String         @map("actor_id")
  action     String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  metadata   Json?

  @@index([at(sort: Desc)], map: "idx_audit_logs_at")
  @@map("audit_logs")
}
