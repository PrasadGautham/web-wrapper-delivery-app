# Core runtime
HOST=0.0.0.0
PORT=8080
SESSION_TTL_HOURS=12
STALE_LOCATION_MINUTES=5
DISPATCH_INTERVAL_MS=5000

# Admin auth
ADMIN_API_KEY=replace-with-a-strong-random-secret
ALLOW_ADMIN_API_KEY_FALLBACK=false

# Browser security and observability
ALLOWED_WEB_ORIGINS=
METRICS_API_KEY=

# Firebase Admin SDK for backend-driven FCM
FIREBASE_SERVICE_ACCOUNT_PATH=C:\dev\secrets\driverapp-firebase-admin.json

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/driver_app?schema=public

# Optional Redis for shared multi-instance rate limiting
REDIS_URL=

# Optional traffic-aware ETA
GOOGLE_MAPS_API_KEY=

# Optional alert webhook
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300

# Optional SMTP password reset delivery
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_BASE_URL=

# Optional isolated database for integration tests
POSTGRES_TEST_DATABASE_URL=

# Optional password reset tuning
PASSWORD_RESET_TTL_MINUTES=15
ALLOW_INSECURE_PASSWORD_RESET_TOKEN_RESPONSE=false
