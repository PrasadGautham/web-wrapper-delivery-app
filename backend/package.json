    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.4.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
