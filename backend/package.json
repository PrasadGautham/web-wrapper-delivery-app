{
  "name": "driver-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && node dist-test/test/run-tests.js",
    "test:postgres": "tsc -p tsconfig.json --outDir dist-test && node dist-test/test/postgres-integration.test.js",
    "smoke:deploy": "tsx scripts/deployment-smoke-check.ts",
